* text=auto

# Windows 脚本保持 CRLF，避免 cmd/PowerShell 解析问题
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 代码与文档统一 LF
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=crlf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.html text eol=lf
*.css text eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.7z binary
